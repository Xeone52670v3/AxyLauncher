// ============================================================================
// MATERIAL DESIGN 3 DYNAMIC PALETTE (DARK + LIGHT + CATPPUCCIN + ROSÉ PINE)
// ============================================================================
export global M3 {
    // 0 = Bay Blue, 1 = Aloe Sage, 2 = Rose Quartz, 3 = Lemongrass,
    // 4 = Lavender, 5 = Catppuccin Mocha, 6 = Rosé Pine, 7 = Custom Color
    in-out property <int> scheme: 0;
    in-out property <bool> light-mode: false;
    in-out property <float> radius-scale: 1.0;
    in-out property <int> widget-frame-idx: 0;
    in-out property <int> icon-theme-idx: 0;
    in-out property <string> ui-font: "";
    in-out property <bool> animations-enabled: true;
    in-out property <bool> wavy-progress: true;

    // Dynamic custom color tokens computed from user's chosen hex color (scheme == 7)
    in-out property <color> custom-dark-bg: #100E18;
    in-out property <color> custom-dark-surface-low: #171422;
    in-out property <color> custom-dark-surface: #1F1B2E;
    in-out property <color> custom-dark-surface-high: #2A253D;
    in-out property <color> custom-dark-surface-highest: #362F4E;
    in-out property <color> custom-dark-primary: #C4B5FD;
    in-out property <color> custom-dark-on-primary: #24144D;
    in-out property <color> custom-dark-primary-container: #432E80;
    in-out property <color> custom-dark-on-primary-container: #EDE9FE;
    in-out property <color> custom-dark-secondary-container: #383052;
    in-out property <color> custom-dark-on-secondary-container: #E4DDF8;
    in-out property <color> custom-dark-outline-variant: #3D3656;

    in-out property <color> custom-light-bg: #F6F4FB;
    in-out property <color> custom-light-surface-low: #EEEAF7;
    in-out property <color> custom-light-surface: #FFFFFF;
    in-out property <color> custom-light-surface-high: #E4DEF2;
    in-out property <color> custom-light-surface-highest: #D9D0EC;
    in-out property <color> custom-light-primary: #6344B8;
    in-out property <color> custom-light-primary-container: #E5DCFC;
    in-out property <color> custom-light-on-primary-container: #1F0F4D;
    in-out property <color> custom-light-secondary-container: #E5DFF2;
    in-out property <color> custom-light-outline-variant: #CCC4DF;

    out property <color> bg: light-mode ? (
        scheme == 7 ? custom-light-bg :
        scheme == 1 ? #F2F7F3 :
        scheme == 2 ? #FBF4F6 :
        scheme == 3 ? #FAF8F0 :
        scheme == 4 ? #F6F3FB :
        scheme == 5 ? #EFF1F5 :
        scheme == 6 ? #FAF4ED : #F4F7FC
    ) : (
        scheme == 7 ? custom-dark-bg :
        scheme == 1 ? #0B100D :
        scheme == 2 ? #130C0E :
        scheme == 3 ? #100F0A :
        scheme == 4 ? #0E0C14 :
        scheme == 5 ? #11111B :
        scheme == 6 ? #191724 : #0C0F16
    );

    out property <color> surface-low: light-mode ? (
        scheme == 7 ? custom-light-surface-low :
        scheme == 1 ? #E8F1EB :
        scheme == 2 ? #F5E9EC :
        scheme == 3 ? #F3EFE2 :
        scheme == 4 ? #EDE8F7 :
        scheme == 5 ? #E6E9EF :
        scheme == 6 ? #F2E9E1 : #EBF0F9
    ) : (
        scheme == 7 ? custom-dark-surface-low :
        scheme == 1 ? #121A15 :
        scheme == 2 ? #1B1215 :
        scheme == 3 ? #18160F :
        scheme == 4 ? #16131F :
        scheme == 5 ? #181825 :
        scheme == 6 ? #1F1D2E : #121621
    );

    out property <color> surface: light-mode ? (
        scheme == 7 ? custom-light-surface :
        scheme == 1 ? #FFFFFF :
        scheme == 2 ? #FFFFFF :
        scheme == 3 ? #FFFFFF :
        scheme == 4 ? #FFFFFF :
        scheme == 5 ? #F7F8FB :
        scheme == 6 ? #FFFAF3 : #FFFFFF
    ) : (
        scheme == 7 ? custom-dark-surface :
        scheme == 1 ? #17211B :
        scheme == 2 ? #23181C :
        scheme == 3 ? #201D15 :
        scheme == 4 ? #1D1A28 :
        scheme == 5 ? #1E1E2E :
        scheme == 6 ? #26233A : #181D2A
    );

    out property <color> surface-high: light-mode ? (
        scheme == 7 ? custom-light-surface-high :
        scheme == 1 ? #DCE9E0 :
        scheme == 2 ? #EDDDE2 :
        scheme == 3 ? #EAE4D2 :
        scheme == 4 ? #E3DCF2 :
        scheme == 5 ? #DCE0E8 :
        scheme == 6 ? #EBDCD0 : #DFE7F5
    ) : (
        scheme == 7 ? custom-dark-surface-high :
        scheme == 1 ? #202D25 :
        scheme == 2 ? #2E2025 :
        scheme == 3 ? #2B271C :
        scheme == 4 ? #272335 :
        scheme == 5 ? #292A3D :
        scheme == 6 ? #312E48 : #212838
    );

    out property <color> surface-highest: light-mode ? (
        scheme == 7 ? custom-light-surface-highest :
        scheme == 1 ? #CFE0D4 :
        scheme == 2 ? #E3CFD5 :
        scheme == 3 ? #DFD8C0 :
        scheme == 4 ? #D7CEEB :
        scheme == 5 ? #CCD0DA :
        scheme == 6 ? #DFCFC2 : #D2DDF0
    ) : (
        scheme == 7 ? custom-dark-surface-highest :
        scheme == 1 ? #2A3A30 :
        scheme == 2 ? #3A2930 :
        scheme == 3 ? #363224 :
        scheme == 4 ? #322D43 :
        scheme == 5 ? #313244 :
        scheme == 6 ? #403D52 : #2B3347
    );

    out property <color> primary: light-mode ? (
        scheme == 7 ? custom-light-primary :
        scheme == 1 ? #1B6D3D :
        scheme == 2 ? #9C2F57 :
        scheme == 3 ? #7B5D00 :
        scheme == 4 ? #654EA3 :
        scheme == 5 ? #8839EF :
        scheme == 6 ? #B4637A : #1D5BBF
    ) : (
        scheme == 7 ? custom-dark-primary :
        scheme == 1 ? #8CD8A5 :
        scheme == 2 ? #FFB1C8 :
        scheme == 3 ? #E8C766 :
        scheme == 4 ? #D0BCFF :
        scheme == 5 ? #CBA6F7 :
        scheme == 6 ? #EBBCBA : #A8C7FA
    );

    out property <color> on-primary: light-mode ? #FFFFFF : (
        scheme == 7 ? custom-dark-on-primary :
        scheme == 1 ? #00391B :
        scheme == 2 ? #5E1133 :
        scheme == 3 ? #3E2E00 :
        scheme == 4 ? #381E72 :
        scheme == 5 ? #1E1E2E :
        scheme == 6 ? #191724 : #062E6F
    );

    out property <color> primary-container: light-mode ? (
        scheme == 7 ? custom-light-primary-container :
        scheme == 1 ? #C5F0D2 :
        scheme == 2 ? #FFD9E3 :
        scheme == 3 ? #FCE397 :
        scheme == 4 ? #E8DDFF :
        scheme == 5 ? #E5D4FA :
        scheme == 6 ? #F5D5DE : #D6E4FF
    ) : (
        scheme == 7 ? custom-dark-primary-container :
        scheme == 1 ? #0F522B :
        scheme == 2 ? #7B2949 :
        scheme == 3 ? #5A4300 :
        scheme == 4 ? #4F378B :
        scheme == 5 ? #453363 :
        scheme == 6 ? #523945 : #1B438F
    );

    out property <color> on-primary-container: light-mode ? (
        scheme == 7 ? custom-light-on-primary-container :
        scheme == 1 ? #00210E :
        scheme == 2 ? #3E001D :
        scheme == 3 ? #261B00 :
        scheme == 4 ? #21005D :
        scheme == 5 ? #2B0F54 :
        scheme == 6 ? #471A28 : #001A43
    ) : (
        scheme == 7 ? custom-dark-on-primary-container :
        scheme == 1 ? #A7F5BF :
        scheme == 2 ? #FFD9E2 :
        scheme == 3 ? #FFE18D :
        scheme == 4 ? #EADDFF :
        scheme == 5 ? #F5E0DC :
        scheme == 6 ? #FADBD9 : #D6E3FF
    );

    out property <color> secondary-container: light-mode ? (
        scheme == 7 ? custom-light-secondary-container :
        scheme == 1 ? #D6E8DB :
        scheme == 2 ? #F2DBE1 :
        scheme == 3 ? #EDE5CE :
        scheme == 4 ? #E7E0F3 :
        scheme == 5 ? #DCDFF0 :
        scheme == 6 ? #EDE0D6 : #DCE3F2
    ) : (
        scheme == 7 ? custom-dark-secondary-container :
        scheme == 1 ? #384B3D :
        scheme == 2 ? #5A3F47 :
        scheme == 3 ? #4E462A :
        scheme == 4 ? #4A4458 :
        scheme == 5 ? #3B3D54 :
        scheme == 6 ? #3E3A54 : #3B4457
    );

    out property <color> on-secondary-container: light-mode ? #1B2432 : (
        scheme == 7 ? custom-dark-on-secondary-container :
        scheme == 1 ? #D2E8D4 :
        scheme == 2 ? #FFD9E2 :
        scheme == 3 ? #EEE2BC :
        scheme == 4 ? #E8DEF8 :
        scheme == 5 ? #CDD6F4 :
        scheme == 6 ? #E0DEF4 : #DAE2F9
    );

    out property <color> tertiary: light-mode ? (
        scheme == 5 ? #EA76CB :
        scheme == 6 ? #286983 : #6B4C8A
    ) : (
        scheme == 1 ? #A2CED9 :
        scheme == 2 ? #EFBD94 :
        scheme == 3 ? #A9D0B3 :
        scheme == 4 ? #EFB8C8 :
        scheme == 5 ? #F5C2E7 :
        scheme == 6 ? #9CCFD8 : #DEBCDF
    );

    out property <color> tertiary-container: light-mode ? (
        scheme == 5 ? #FAD6F0 :
        scheme == 6 ? #D2E8EE : #EFE0FA
    ) : (
        scheme == 1 ? #204D56 :
        scheme == 2 ? #623F20 :
        scheme == 3 ? #2A4E38 :
        scheme == 4 ? #633B48 :
        scheme == 5 ? #543753 :
        scheme == 6 ? #2A4752 : #583E5B
    );

    out property <color> on-surface: light-mode ? #181C24 : (
        scheme == 5 ? #CDD6F4 :
        scheme == 6 ? #E0DEF4 : #ECEEF4
    );
    out property <color> on-surface-variant: light-mode ? #4B5568 : (
        scheme == 5 ? #A6ADC8 :
        scheme == 6 ? #908CAA : #B8C0D0
    );
    out property <color> outline: light-mode ? #768096 : #848B9B;
    out property <color> outline-variant: light-mode ? (
        scheme == 7 ? custom-light-outline-variant : #CCD4E3
    ) : (
        scheme == 7 ? custom-dark-outline-variant :
        scheme == 5 ? #313244 :
        scheme == 6 ? #393552 : #303748
    );
    out property <color> success: light-mode ? #1E7E45 : #7DD89A;
    out property <color> error: light-mode ? #B3261E : #FFB4AB;
    out property <color> error-container: light-mode ? #F9DEDC : #4A1C1C;
}

export global Tr {
    in-out property <int> rev: 0;
    pure callback translate(string, int) -> string;
    public pure function t(s: string) -> string {
        return translate(s, rev);
    }
}

