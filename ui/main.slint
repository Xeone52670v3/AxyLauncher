    loader_version: string,
    icon_id: int,
    icon_image: image,
    optifine_badge: string,
    custom_badge: string,
    status_badge: string,
    playtime_text: string,
}

export global UiIcons {
    in-out property <int> style-idx: 0; // 0=Material, 1=Контурные, 2=Пиксельные, 3=Custom pack
    in-out property <bool> has-add: false;         in-out property <image> img-add;
    in-out property <bool> has-instances: false;   in-out property <image> img-instances;
    in-out property <bool> has-folders: false;     in-out property <image> img-folders;
    in-out property <bool> has-settings: false;    in-out property <image> img-settings;
    in-out property <bool> has-console: false;     in-out property <image> img-console;
    in-out property <bool> has-news: false;        in-out property <image> img-news;
    in-out property <bool> has-account: false;     in-out property <image> img-account;
    in-out property <bool> has-play: false;        in-out property <image> img-play;
    in-out property <bool> has-offline: false;     in-out property <image> img-offline;
    in-out property <bool> has-edit: false;        in-out property <image> img-edit;
    in-out property <bool> has-export: false;      in-out property <image> img-export;
    in-out property <bool> has-copy: false;        in-out property <image> img-copy;
    in-out property <bool> has-delete: false;      in-out property <image> img-delete;
    in-out property <bool> has-check: false;       in-out property <image> img-check;
    in-out property <bool> has-search: false;      in-out property <image> img-search;
    in-out property <bool> has-refresh: false;     in-out property <image> img-refresh;
    in-out property <bool> has-stop: false;        in-out property <image> img-stop;
    in-out property <bool> has-java: false;        in-out property <image> img-java;
    in-out property <bool> has-language: false;    in-out property <image> img-language;
    in-out property <bool> has-proxy: false;       in-out property <image> img-proxy;
    in-out property <bool> has-tools: false;       in-out property <image> img-tools;
    in-out property <bool> has-api: false;         in-out property <image> img-api;
}

