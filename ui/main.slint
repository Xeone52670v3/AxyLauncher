// ============================================================================
// ROCK-SOLID MATERIAL DESIGN 3 SCROLLVIEW
// ============================================================================
component M3ScrollView inherits Rectangle {
    in property <length> content-padding: 0px;
    in property <length> content-spacing: 0px;
    in-out property <length> scroll-y <=> flick.content-y;
    out property <length> visible-width: flick.width;
    out property <length> visible-height: flick.height;
    out property <length> total-content-height: flick.content-height;

    property <length> max-scroll: max(0px, flick.content-height - flick.height);
    property <bool> needs-scroll: max-scroll > 1px;
    property <length> track-h: max(24px, root.height - 8px);
    property <length> thumb-h: flick.content-height > 0px
        ? max(30px, min(track-h, track-h * (flick.height / flick.content-height)))
        : track-h;
    property <length> thumb-y: max-scroll > 0px
        ? (-flick.content-y / max-scroll) * max(0px, track-h - thumb-h)
        : 0px;

    clip: true;
    background: transparent;
    min-width: 48px;
    min-height: 64px;
    preferred-width: 100%;
    preferred-height: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    callback background-clicked();

    flick := Flickable {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        mouse-drag-pan-enabled: false;
        content-width: self.width;
        content-height: max(self.height, inner-col.preferred-height);

        TouchArea {
            x: 0;
            y: 0;
            width: flick.content-width;
            height: flick.content-height;
            clicked => { root.background-clicked(); }
        }

        inner-col := VerticalLayout {
            x: 0;
            y: 0;
            width: flick.width;
            padding: root.content-padding;
            spacing: root.content-spacing;
            alignment: start;
            @children
        }
    }

    if root.needs-scroll : Rectangle {
        x: root.width - 9px;
        y: 4px;
        width: 7px;
        height: root.track-h;
        border-radius: 3.5px;
        background: M3.outline-variant.with-alpha(0.38);

        thumb := Rectangle {
            x: 0;
            y: clamp(root.thumb-y, 0px, max(0px, root.track-h - self.height));
            width: parent.width;
            height: root.thumb-h;
            border-radius: 3.5px;
            background: bar-touch.pressed ? M3.primary : (bar-touch.has-hover ? M3.primary.with-alpha(0.85) : M3.outline);
            animate background { duration: 120ms; }
        }

        bar-touch := TouchArea {
            property <length> press-mouse-y: 0px;
            property <length> press-content-y: 0px;
            property <bool> dragging-thumb: false;

            mouse-cursor: pointer;

            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    if self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height {
                        self.dragging-thumb = true;
                        self.press-mouse-y = self.mouse-y;
                        self.press-content-y = flick.content-y;
                    } else {
                        self.dragging-thumb = false;
                        if root.track-h > root.thumb-h {
                            flick.content-y = -clamp(
                                ((self.mouse-y - root.thumb-h / 2) / (root.track-h - root.thumb-h)) * root.max-scroll,
                                0px,
                                root.max-scroll
                            );
                        }
                    }
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    self.dragging-thumb = false;
                }
            }

            moved => {
                if self.pressed && self.dragging-thumb && root.track-h > root.thumb-h {
                    flick.content-y = -clamp(
                        -self.press-content-y + ((self.mouse-y - self.press-mouse-y) / (root.track-h - root.thumb-h)) * root.max-scroll,
                        0px,
                        root.max-scroll
                    );
                }
            }

            scroll-event(ev) => {
                if ev.delta-y != 0px {
                    flick.content-y = clamp(flick.content-y + ev.delta-y, -root.max-scroll, 0px);
                    return accept;
                }
                reject
            }
        }
    }
}

// ============================================================================
// MATERIAL DESIGN 3 DROPDOWN MENU (FOR LANGUAGE & ENUM OPTIONS)
// ============================================================================
component UiIcon inherits Rectangle {
    in property <string> svg-path;
    in property <color> icon-color: M3.on-surface-variant;
    in property <length> icon-size: 16px;

    property <bool> use-img:
        (svg-path == "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" && UiIcons.has-add) ||
        (svg-path == "M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z" && UiIcons.has-instances) ||
        ((svg-path == "M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" || svg-path == "M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z") && UiIcons.has-folders) ||
        (svg-path == "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" && UiIcons.has-settings) ||
        (svg-path == "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM7.5 17l-1.41-1.41L9.67 12 6.09 8.41 7.5 7l5 5-5 5zm9.5 0h-5v-2h5v2z" && UiIcons.has-console) ||
        (svg-path == "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14H5v-2h6v2zm8-4H5v-2h14v2zm0-4H5V7h14v2z" && UiIcons.has-news) ||
        (svg-path == "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" && UiIcons.has-account) ||
        (svg-path == "M8 5v14l11-7z" && UiIcons.has-play) ||
        (svg-path == "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" && UiIcons.has-offline) ||
        (svg-path == "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" && UiIcons.has-edit) ||
        (svg-path == "M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" && UiIcons.has-export) ||
