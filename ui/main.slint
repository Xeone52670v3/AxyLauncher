                    // EDIT 7: SCREENSHOTS
                    if root.edit-subtab == 7 : VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Скриншоты (" + root.screenshots-list.length + ")"; color: M3.on-surface; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                            M3Chip { text: Tr.t("Открыть папку screenshots"); clicked => { root.open-instance-subfolder("screenshots"); } }
                        }
