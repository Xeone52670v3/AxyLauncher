    // Native cross-platform clipboard helper via Slint's built-in TextInput (NO wl-copy / xclip needed!)
    native-clip := TextInput {
        x: -400px;
        y: -400px;
        width: 10px;
        height: 10px;
        opacity: 0;
        single-line: false;
    }

    public function copy-to-clipboard-native(val: string) {
        native-clip.text = val;
        native-clip.select-all();
        native-clip.copy();
    }

    // Optional Full-Launcher Custom Background Layer
    if root.setting-enable-custom-bg && (root.setting-custom-bg-mode == 0 || root.setting-custom-bg-mode == 2 || root.setting-custom-bg-mode == 3) && root.has-launcher-bg-image : Image {
        width: 100%;
        height: 100%;
        source: root.custom-bg-launcher-image;
        image-fit: root.setting-bg-launcher-scale == 0 ? contain : (root.setting-bg-launcher-scale == 2 ? fill : cover);
        opacity: root.setting-bg-launcher-opacity;
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding: 10px;
        spacing: 10px;

        // ====================================================================
        // TOP TOOLBAR (NO CATALOG TAB — MODPACKS IN ADD INSTANCE, REPOS IN SETTINGS!)
        // ====================================================================
        Rectangle {
            height: 58px;
            min-width: 0px;
            clip: true;
            background: M3.surface;
            border-radius: 22px;
            border-width: 1px;
            border-color: M3.outline-variant;

            // Jumping Active Tab Capsule across Top Toolbar
            Rectangle {
                y: (parent.height - 36px) / 2;
                height: 36px;
                border-radius: 18px * M3.radius-scale;
                background: M3.primary-container;
                border-width: 1.5px;
                border-color: M3.primary;
                opacity: (root.active-tab == 1 || (root.active-tab == 2 && !root.setting-show-news-toolbar)) ? 0.0 : 1.0;
                x: tb-left.x + (root.active-tab == 2 ? tb-news.x : (root.active-tab == 3 ? tb-settings.x : (root.active-tab == 4 ? tb-console.x : tb-instances.x)));
                width: root.active-tab == 2 ? tb-news.width : (root.active-tab == 3 ? tb-settings.width : (root.active-tab == 4 ? tb-console.width : tb-instances.width));
                animate x, width { duration: M3.animations-enabled ? 240ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                animate opacity { duration: M3.animations-enabled ? 150ms : 0ms; }
            }

            tb-host := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                tb-left := HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    M3PrimaryButton {
                        y: (parent.height - self.height) / 2;
                        btn-height: 38px;
                        text: Tr.t("Добавить сборку");
                        svg-path: "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z";
                        clicked => {
                            root.create-mode-idx = 0;
                            root.new-inst-name = "";
                            root.new-inst-mc-version = "";
                            root.new-inst-loader-version = "";
                            root.randomize-new-icon();
                            root.show-create-modal = true;
                            root.refresh-versions(root.new-inst-loader-idx, "", root.include-snapshots);
                        }
                    }

                    tb-instances := M3ToolbarButton {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("Сборки");
                        svg-path: "M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z";
                        managed-pill: true;
                        active: root.active-tab == 0 || root.active-tab == 5;
                        clicked => { root.active-tab = 0; }
                    }

                    M3ToolbarButton {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("Папки");
                        svg-path: "M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z";
                        clicked => { root.open-root-folder(); }
                    }

                    tb-news := M3ToolbarButton {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("Новости");
                        svg-path: "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14H5v-2h6v2zm8-4H5v-2h14v2zm0-4H5V7h14v2z";
                        managed-pill: true;
                        active: root.active-tab == 2;
                        visible: root.setting-show-news-toolbar;
                        max-width: root.setting-show-news-toolbar ? 240px : 0px;
                        min-width: 0px;
                        clip: true;
                        clicked => {
                            root.active-tab = 2;
                            root.refresh-news(root.news-filter-idx);
                        }
                    }

                    tb-settings := M3ToolbarButton {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("Настройки");
                        svg-path: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                        managed-pill: true;
                        active: root.active-tab == 3;
                        clicked => { root.active-tab = 3; }
                    }

                    tb-console := M3ToolbarButton {
                        y: (parent.height - self.height) / 2;
                        text: Tr.t("Консоль");
                        svg-path: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM7.5 17l-1.41-1.41L9.67 12 6.09 8.41 7.5 7l5 5-5 5zm9.5 0h-5v-2h5v2z";
                        managed-pill: true;
                        active: root.active-tab == 4;
                        clicked => { root.active-tab = 4; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 19px;
                        background: theme-t.has-hover ? M3.surface-highest : M3.surface-high;
                        border-width: 1px;
                        border-color: M3.outline-variant;

                        Path {
                            width: 18px;
                            height: 18px;
                            x: 10px;
                            y: 10px;
                            commands: M3.light-mode
                                ? "M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
                                : "M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zM12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm8 4.5v2h3v-2h-3zm-2.76 7.66l1.79 1.8 1.41-1.41-1.8-1.79-1.4 1.4zM11 20.45h2v2.95h-2v-2.95zM3.55 18.54l1.41 1.41 1.79-1.8-1.41-1.41-1.79 1.8z";
                            fill: M3.primary;
                        }

                        theme-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                M3.light-mode = !M3.light-mode;
                                root.save-settings(M3.scheme, M3.light-mode);
                            }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 19px;
                        background: root.active-tab == 1 ? M3.primary-container : (acc-t.has-hover ? M3.surface-highest : M3.surface-high);
                        border-width: 1px;
                        border-color: root.active-tab == 1 ? M3.primary : M3.outline-variant;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 12px;
                                background: M3.primary;
                                Path {
                                    width: 14px;
                                    height: 14px;
                                    x: 5px;
                                    y: 5px;
                                    commands: "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
                                    fill: M3.on-primary;
                                }
                            }

                            Text {
                                max-width: 180px;
                                text: root.active-account-type != "" ? root.active-account-name + " (" + root.active-account-type + ")" : root.active-account-name;
                                color: root.active-tab == 1 ? M3.on-primary-container : M3.on-surface;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        acc-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-tab = 1;
                                root.refresh-patcher-versions(root.setting-auth-backend-idx);
                            }
                        }
                    }
                }
            }
        }

        // ====================================================================
        // STATIC STRETCHING CONTENT HOST (PREVENTS ANY `if` COLLAPSE!)
        // ====================================================================
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // ================================================================
            // VIEW 0: MAIN 2-PANE INSTANCES VIEW
            // ================================================================
            HorizontalLayout {
                visible: self.opacity > 0.01;
                opacity: root.active-tab == 0 ? 1.0 : 0.0;
                animate opacity { duration: M3.animations-enabled ? 160ms : 0ms; }
                width: 100%;
                height: 100%;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: M3.surface;
                    border-radius: 26px;
                    border-width: 1px;
                    border-color: M3.outline-variant;
                    clip: true;

                    // Custom Instances Background Overlay (when enabled for Instances / Both / Separate)
                    if root.setting-enable-custom-bg && (root.setting-custom-bg-mode == 1 || root.setting-custom-bg-mode == 2 || root.setting-custom-bg-mode == 3) && (root.setting-custom-bg-mode == 3 ? root.has-instances-bg-image : root.has-launcher-bg-image) : Image {
                        width: 100%;
                        height: 100%;
                        source: root.setting-custom-bg-mode == 3 ? root.custom-bg-instances-image : root.custom-bg-launcher-image;
                        image-fit: (root.setting-custom-bg-mode == 3 ? root.setting-bg-instances-scale : root.setting-bg-launcher-scale) == 0 ? contain : ((root.setting-custom-bg-mode == 3 ? root.setting-bg-instances-scale : root.setting-bg-launcher-scale) == 2 ? fill : cover);
                        opacity: root.setting-custom-bg-mode == 3 ? root.setting-bg-instances-opacity : root.setting-bg-launcher-opacity;
                    }

                    // Cat Pack Background Overlay (high-detail procedural cats or user file)
                    if root.setting-enable-cat-pack && root.has-cat-image : Image {
                        x: root.setting-cat-scale-mode == 0 ? parent.width - 250px : 0px;
                        y: root.setting-cat-scale-mode == 0 ? parent.height - 250px : 0px;
                        width: root.setting-cat-scale-mode == 0 ? 236px : parent.width;
                        height: root.setting-cat-scale-mode == 0 ? 236px : parent.height;
                        source: root.cat-pack-image;
                        image-fit: root.setting-cat-scale-mode == 0 ? contain : (root.setting-cat-scale-mode == 3 ? fill : cover);
                        opacity: root.setting-cat-opacity;
                    }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;

                            M3TextField {
                                horizontal-stretch: 1;
                                text <=> root.instance-search-query;
                                placeholder: Tr.t("Поиск сборок по названию, версии или загрузчику...");
                                edited(q) => { root.filter-instances(q, root.instance-group-filter, root.setting-sort-mode); }
                            }

                            Rectangle {
                                horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                height: 38px;
                                border-radius: 19px * M3.radius-scale;
                                background: M3.surface-high;
                                border-width: 1px;
                                border-color: M3.outline-variant;

                                Rectangle {
                                    y: 2px;
                                    height: 34px;
                                    border-radius: 17px * M3.radius-scale;
                                    background: M3.primary-container;
                                    border-width: 1.5px;
                                    border-color: M3.primary;
                                    x: root.setting-sort-mode == "По времени запуска" ? sort-1.x : (root.setting-sort-mode == "По времени игры" ? sort-2.x : sort-0.x);
                                    width: root.setting-sort-mode == "По времени запуска" ? sort-1.width : (root.setting-sort-mode == "По времени игры" ? sort-2.width : sort-0.width);
                                    animate x, width { duration: M3.animations-enabled ? 220ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                }

                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 4px;
                                    sort-0 := M3Chip {
                                        managed-pill: true;
                                        text: Tr.t("Имя");
                                        selected: root.setting-sort-mode == "По имени";
                                        clicked => {
                                            root.setting-sort-mode = "По имени";
                                            root.filter-instances(root.instance-search-query, root.instance-group-filter, "По имени");
                                        }
                                    }
                                    sort-1 := M3Chip {
                                        managed-pill: true;
                                        text: Tr.t("Недавние");
                                        selected: root.setting-sort-mode == "По времени запуска";
                                        clicked => {
                                            root.setting-sort-mode = "По времени запуска";
                                            root.filter-instances(root.instance-search-query, root.instance-group-filter, "По времени запуска");
                                        }
                                    }
                                    sort-2 := M3Chip {
                                        managed-pill: true;
                                        text: Tr.t("Время игры");
                                        selected: root.setting-sort-mode == "По времени игры";
                                        clicked => {
                                            root.setting-sort-mode = "По времени игры";
                                            root.filter-instances(root.instance-search-query, root.instance-group-filter, "По времени игры");
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            grp-track := Rectangle {
                                height: 38px;
                                border-radius: 19px * M3.radius-scale;
                                background: M3.surface-high;
                                border-width: 1px;
                                border-color: M3.outline-variant;

                                in-out property <length> active-x: 2px;
                                in-out property <length> active-w: 44px;

                                Rectangle {
                                    y: 2px;
                                    height: 34px;
                                    border-radius: 17px * M3.radius-scale;
                                    background: M3.primary-container;
                                    border-width: 1.5px;
                                    border-color: M3.primary;
                                    x: grp-track.active-x;
                                    width: grp-track.active-w;
                                    animate x, width { duration: M3.animations-enabled ? 220ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                }

                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 4px;
                                    for grp in root.instance-groups : M3Chip {
                                        managed-pill: true;
                                        text: grp;
                                        selected: root.instance-group-filter == grp;
                                        property <bool> is-active: root.instance-group-filter == grp;
                                        property <length> chip-x: self.x;
                                        property <length> chip-w: self.width;
                                        init => {
                                            if self.is-active {
                                                grp-track.active-x = self.x;
                                                grp-track.active-w = self.width;
                                            }
                                        }
                                        changed is-active => {
                                            if self.is-active {
                                                grp-track.active-x = self.x;
                                                grp-track.active-w = self.width;
                                            }
                                        }
                                        changed chip-x => {
                                            if self.is-active { grp-track.active-x = self.x; }
                                        }
                                        changed chip-w => {
                                            if self.is-active { grp-track.active-w = self.width; }
                                        }
                                        clicked => {
                                            grp-track.active-x = self.x;
                                            grp-track.active-w = self.width;
                                            root.instance-group-filter = grp;
                                            root.filter-instances(root.instance-search-query, grp, root.setting-sort-mode);
                                        }
                                    }
                                }
                            }
                        }

                        M3ScrollView {
                            vertical-stretch: 1;
                            content-spacing: 8px;
                            background-clicked => { root.select-instance(""); }

                            for inst[idx] in root.instances : Rectangle {
                                min-height: root.setting-instance-card-size == 0 ? 58px : (root.setting-instance-card-size == 2 ? 96px : 78px);
                                border-radius: 20px * M3.radius-scale;
                                background: idx == root.selected-instance-index ? M3.primary-container : (inst-t.has-hover ? M3.surface-high : M3.surface-low);
                                border-width: idx == root.selected-instance-index ? 2px : 1px;
                                border-color: idx == root.selected-instance-index ? M3.primary : M3.outline-variant;
                                animate background, border-color { duration: 130ms; }

                                HorizontalLayout {
                                    padding: root.setting-instance-card-size == 0 ? 10px : (root.setting-instance-card-size == 2 ? 18px : 14px);
                                    spacing: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        spacing: 14px;

                                        VerticalLayout {
                                            horizontal-stretch: 0;
                                            alignment: center;
                                            InstanceIconBadge {
                                                size: root.setting-instance-card-size == 0 ? 36px : (root.setting-instance-card-size == 2 ? 60px : 48px);
                                                icon-id: inst.icon_id;
                                                icon-image: inst.icon_image;
                                                label: inst.loader == "Horizon (Rust)" ? "HRZ" : inst.loader;
                                                selected: idx == root.selected-instance-index;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: inst.name;
                                                color: idx == root.selected-instance-index ? M3.on-primary-container : M3.on-surface;
                                                font-size: root.setting-instance-card-size == 0 ? 13px : (root.setting-instance-card-size == 2 ? 17px : 15px);
                                                font-weight: 700;
                                                wrap: root.setting-wrap-instance-names ? word-wrap : no-wrap;
                                                overflow: root.setting-wrap-instance-names ? clip : elide;
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Rectangle {
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: idx == root.selected-instance-index ? M3.on-primary : M3.surface-high;
                                                    HorizontalLayout {
                                                        padding-left: 9px;
                                                        padding-right: 9px;
                                                        Text {
                                                            text: inst.mc_version + " • " + inst.loader;
                                                            color: idx == root.selected-instance-index ? M3.primary : M3.on-surface-variant;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                if inst.optifine_badge != "" : Rectangle {
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: M3.tertiary-container;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Text { text: inst.optifine_badge; color: M3.tertiary; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                                    }
                                                }
                                                if inst.custom_badge != "" : Rectangle {
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: M3.surface-highest;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Text { text: inst.custom_badge; color: M3.primary; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 0;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: inst.group; color: idx == root.selected-instance-index ? M3.on-primary-container : M3.on-surface-variant; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
                                        if root.setting-show-playtime-instances : Text { text: inst.playtime_text; color: M3.success; font-size: 10px; font-weight: 600; horizontal-alignment: right; }
                                    }
                                }

                                inst-t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-instance(inst.id); }
                                    double-clicked => {
                                        root.select-instance(inst.id);
                                        root.launch-selected-instance(false);
                                    }
                                }
                            }
                        }
                    }
                }

                // RIGHT ACTION SIDEBAR (ONLY SHOWN WHEN AN INSTANCE IS SELECTED!)
                if root.selected-instance-index >= 0 && root.instances.length > 0 : Rectangle {
                    width: 272px;
                    background: M3.surface;
                    border-radius: 26px;
                    border-width: 1px;
                    border-color: M3.outline-variant;

                    M3ScrollView {
                        width: 100%;
                        height: 100%;
                        content-padding: 16px;
                        content-spacing: 10px;

                        VerticalLayout {
                            spacing: 8px;
                            alignment: center;

                            InstanceIconBadge {
                                x: (parent.width - self.width) / 2;
                                size: 76px;
                                icon-id: root.selected-instance-icon-id;
                                icon-image: root.selected-instance-icon-image;
                                label: root.selected-instance-loader == "Horizon (Rust)" ? "Horizon" : root.selected-instance-loader;
                                selected: true;
                            }

                            Text { text: root.selected-instance-name; color: M3.on-surface; font-size: 16px; font-weight: 800; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: root.selected-instance-mc + " • " + root.selected-instance-loader + " " + root.selected-instance-loader-ver; color: M3.on-surface-variant; font-size: 11px; horizontal-alignment: center; }
                            if root.setting-show-playtime-instances : Text { text: root.selected-instance-playtime; color: M3.success; font-size: 11px; font-weight: 600; horizontal-alignment: center; }
                        }

                        if !root.is-game-running : M3PrimaryButton {
                            btn-height: 46px;
                            text: root.is-busy ? "Подготовка..." : "Запустить";
                            svg-path: "M8 5v14l11-7z";
                            enabled: !root.is-busy;
                            clicked => { root.launch-selected-instance(false); }
                        }

                        if root.is-game-running : M3PrimaryButton {
                            btn-height: 46px;
                            danger: true;
                            text: Tr.t("Остановить игру");
                            svg-path: "M6 6h12v12H6z";
                            clicked => { root.kill-running-instance(); }
                        }

                        Rectangle { height: 1px; background: M3.outline-variant; }

                        VerticalLayout {
                            spacing: 3px;

                            M3SidebarAction {
                                text: Tr.t("Запустить офлайн");
                                svg-path: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z";
                                clicked => { root.launch-selected-instance(true); }
                            }

                            M3SidebarAction {
                                text: Tr.t("Редактировать");
                                svg-path: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z";
                                clicked => { root.open-edit-instance(); }
                            }

                            // Split Export button: unified pill with matching background and shared hover
                            Rectangle {
                                height: 38px;
                                border-radius: 14px;
                                background: root.show-export-menu
                                    ? M3.primary-container
                                    : ((exp-main-t.has-hover || exp-arr-t.has-hover) ? M3.surface-high : transparent);
                                animate background { duration: 120ms; }

                                HorizontalLayout {
                                    spacing: 0px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        background: transparent;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 6px;
                                            spacing: 10px;
                                            alignment: start;
                                            Path {
                                                width: 17px;
                                                height: 17px;
                                                y: (parent.height - self.height) / 2;
                                                commands: "M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z";
                                                fill: root.show-export-menu ? M3.on-primary-container : M3.on-surface-variant;
                                            }
                                            Text {
                                                text: Tr.t("Экспорт (.zip)");
                                                color: root.show-export-menu ? M3.on-primary-container : M3.on-surface;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        exp-main-t := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.show-export-menu = false;
                                                root.export-selected-instance("prism");
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 34px;
                                        background: transparent;
                                        Path {
                                            width: 16px;
                                            height: 16px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            commands: root.show-export-menu
                                                ? "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"
                                                : "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z";
                                            fill: root.show-export-menu ? M3.on-primary-container : M3.on-surface-variant;
                                        }
                                        exp-arr-t := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.show-export-menu = !root.show-export-menu; }
                                        }
                                    }
                                }
                            }

                            if root.show-export-menu : Rectangle {
                                border-radius: 14px;
                                background: M3.surface-low;
                                border-width: 1px;
                                border-color: M3.primary;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 3px;
                                    Text {
                                        text: "  Формат экспорта:";
                                        color: M3.primary;
                                        font-size: 11px;
                                        font-weight: 700;
                                    }
                                    M3SidebarAction {
                                        text: "Prism / Freesm (.zip)";
                                        svg-path: "M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z";
                                        clicked => {
                                            root.show-export-menu = false;
                                            root.export-selected-instance("prism");
                                        }
                                    }
                                    M3SidebarAction {
                                        text: "CurseForge (.zip)";
                                        svg-path: "M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z";
                                        clicked => {
                                            root.show-export-menu = false;
                                            root.export-selected-instance("curseforge");
                                        }
                                    }
                                    M3SidebarAction {
                                        text: "Modrinth (.mrpack)";
                                        svg-path: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5";
                                        clicked => {
                                            root.show-export-menu = false;
                                            root.export-selected-instance("modrinth");
                                        }
                                    }
                                }
                            }

                            M3SidebarAction {
                                text: Tr.t("Папка сборки");
                                svg-path: "M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z";
                                clicked => { root.open-instance-folder(); }
                            }

                            M3SidebarAction {
                                text: Tr.t("Копировать сборку");
                                svg-path: "M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z";
                                clicked => { root.duplicate-selected-instance(); }
                            }

                            M3SidebarAction {
                                text: Tr.t("Консоль / Логи");
                                svg-path: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM7.5 17l-1.41-1.41L9.67 12 6.09 8.41 7.5 7l5 5-5 5zm9.5 0h-5v-2h5v2z";
                                clicked => { root.active-tab = 4; }
                            }

                            M3SidebarAction {
                                text: Tr.t("Удалить сборку");
                                svg-path: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z";
                                danger: true;
                                clicked => { root.delete-selected-instance(); }
                            }
                        }
                    }
                }
            }

            // ================================================================
            // VIEW 5: FULL EDIT INSTANCE (10 SECTIONS + CURSEFORGE & MODRINTH!)
            // ================================================================
            HorizontalLayout {
                visible: self.opacity > 0.01;
                opacity: root.active-tab == 5 ? 1.0 : 0.0;
                animate opacity { duration: M3.animations-enabled ? 160ms : 0ms; }
                width: 100%;
                height: 100%;
                spacing: 10px;

                Rectangle {
                    width: 242px;
                    background: M3.surface;
                    border-radius: 26px;
                    border-width: 1px;
                    border-color: M3.outline-variant;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        M3ScrollView {
                            vertical-stretch: 1;
                            content-spacing: 4px;

                            M3Chip { text: Tr.t("← Назад к сборкам"); clicked => { root.active-tab = 0; } }
                            Rectangle { height: 6px; background: transparent; }

                            Text { text: root.edit-inst-name; color: M3.on-surface; font-size: 14px; font-weight: 800; wrap: word-wrap; }
                            Rectangle { height: 6px; background: transparent; }

                            Rectangle {
                                background: transparent;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width;
                                    height: 36px;
                                    border-radius: 18px * M3.radius-scale;
                                    background: M3.primary-container;
                                    border-width: 1.5px;
                                    border-color: M3.primary;
                                    y: (
                                        root.edit-subtab == 1 ? ed-btn-1.y :
                                        root.edit-subtab == 2 ? ed-btn-2.y :
                                        root.edit-subtab == 3 ? ed-btn-3.y :
                                        root.edit-subtab == 4 ? ed-btn-4.y :
                                        root.edit-subtab == 5 ? ed-btn-5.y :
                                        root.edit-subtab == 6 ? ed-btn-6.y :
                                        root.edit-subtab == 7 ? ed-btn-7.y :
                                        root.edit-subtab == 8 ? ed-btn-8.y :
                                        root.edit-subtab == 9 ? ed-btn-9.y : ed-btn-0.y
                                    );
                                    animate y { duration: M3.animations-enabled ? 240ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    ed-btn-0 := M3ToolbarButton { managed-pill: true; text: Tr.t("Журнал"); svg-path: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z"; active: root.edit-subtab == 0; clicked => { root.edit-subtab = 0; } }
                                    ed-btn-1 := M3ToolbarButton { managed-pill: true; text: Tr.t("Версия"); svg-path: "M12 2L2 7l10 5 10-5-10-5zm0 7.5l-6-3 6-3 6 3-6 3z"; active: root.edit-subtab == 1; clicked => { root.edit-subtab = 1; } }
                                    ed-btn-2 := M3ToolbarButton { managed-pill: true; text: "Моды (" + root.installed-mods.length + ")"; svg-path: "M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"; active: root.edit-subtab == 2; clicked => { root.edit-subtab = 2; } }
                                    ed-btn-3 := M3ToolbarButton { managed-pill: true; text: "Ресурспаки (" + root.resource-packs.length + ")"; svg-path: "M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9z"; active: root.edit-subtab == 3; clicked => { root.edit-subtab = 3; } }
                                    ed-btn-4 := M3ToolbarButton { managed-pill: true; text: "Шейдеры (" + root.shader-packs.length + ")"; svg-path: "M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zM12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6z"; active: root.edit-subtab == 4; clicked => { root.edit-subtab = 4; } }
                                    ed-btn-5 := M3ToolbarButton { managed-pill: true; text: "Датапаки (" + root.data-packs.length + ")"; svg-path: "M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-2 10H6v-2h12v2zm0-4H6v-2h12v2z"; active: root.edit-subtab == 5; clicked => { root.edit-subtab = 5; } }
                                    ed-btn-6 := M3ToolbarButton { managed-pill: true; text: "Миры (" + root.worlds-list.length + ")"; svg-path: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93z"; active: root.edit-subtab == 6; clicked => { root.edit-subtab = 6; } }
                                    ed-btn-7 := M3ToolbarButton { managed-pill: true; text: "Скриншоты (" + root.screenshots-list.length + ")"; svg-path: "M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"; active: root.edit-subtab == 7; clicked => { root.edit-subtab = 7; } }
                                    ed-btn-8 := M3ToolbarButton { managed-pill: true; text: Tr.t("Заметки"); svg-path: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"; active: root.edit-subtab == 8; clicked => { root.edit-subtab = 8; } }
                                    ed-btn-9 := M3ToolbarButton { managed-pill: true; text: Tr.t("Настройки"); svg-path: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"; active: root.edit-subtab == 9; clicked => { root.edit-subtab = 9; } }
                                }
                            }
                        }

                        M3PrimaryButton {
                            text: Tr.t("Сохранить");
                            svg-path: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
                            clicked => { root.save-instance-settings(); }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: M3.surface;
                    border-radius: 26px;
                    border-width: 1px;
                    border-color: M3.outline-variant;

                    // EDIT 0: CONSOLE / LOGS
                    if root.edit-subtab == 0 : VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 20px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: Tr.t("Журнал сборки"); color: M3.on-surface; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 38px;
                                    border-radius: 19px * M3.radius-scale;
                                    background: M3.surface-high;
                                    border-width: 1px;
                                    border-color: M3.outline-variant;

                                    Rectangle {
                                        y: 2px;
                                        height: 34px;
                                        border-radius: 17px * M3.radius-scale;
                                        background: M3.primary-container;
                                        border-width: 1.5px;
                                        border-color: M3.primary;
                                        x: root.console-filter-idx == 1 ? ed-flt-1.x : ed-flt-0.x;
                                        width: root.console-filter-idx == 1 ? ed-flt-1.width : ed-flt-0.width;
                                        animate x, width { duration: M3.animations-enabled ? 220ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                    }

                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 4px;
                                        ed-flt-0 := M3Chip { managed-pill: true; text: Tr.t("Все"); selected: root.console-filter-idx == 0; clicked => { root.console-filter-idx = 0; root.set-console-filter(0); } }
                                        ed-flt-1 := M3Chip { managed-pill: true; text: Tr.t("Ошибки"); selected: root.console-filter-idx == 1; clicked => { root.console-filter-idx = 1; root.set-console-filter(1); } }
                                    }
                                }
                                M3Chip {
                                    y: (parent.height - self.height) / 2;
                                    text: Tr.t("Копировать");
                                    clicked => {
                                        root.copy-to-clipboard-native(root.console-log);
                                        root.status-text = "Журнал скопирован в буфер обмена";
                                    }
                                }
                                M3Chip { y: (parent.height - self.height) / 2; text: "Загрузить (" + root.setting-paste-type + ")"; clicked => { root.upload-console-log(); } }
                                M3Chip { y: (parent.height - self.height) / 2; text: Tr.t("Очистить"); clicked => { root.clear-console(); } }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: M3.bg;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: M3.outline-variant;
                            M3ScrollView {
                                width: 100%;
                                height: 100%;
                                content-padding: 14px;
                                TextInput {
                                    width: 100%;
                                    text: root.console-log;
                                    read-only: true;
                                    single-line: false;
                                    color: M3.on-surface;
                                    selection-background-color: M3.primary-container;
                                    selection-foreground-color: M3.on-primary-container;
                                    font-size: root.console-font-size-px;
                                    font-family: root.setting-console-font;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // EDIT 1: VERSION & COMPONENTS
                    if root.edit-subtab == 1 : M3ScrollView {
                        width: 100%;
                        height: 100%;
                        content-padding: 22px;
                        content-spacing: 14px;

                        Text { text: Tr.t("Версия, иконка и компоненты сборки"); color: M3.on-surface; font-size: 18px; font-weight: 800; }

                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 16px;
                                background: transparent;
                                InstanceIconBadge {
                                    size: 56px;
                                    icon-id: root.edit-inst-icon-id;
                                    icon-image: root.edit-inst-icon-image;
                                    label: "ICON";
                                    selected: edit-ic-t.has-hover;
                                }
                                edit-ic-t := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.icon-picker-for-new = false;
                                        root.show-icon-picker-modal = true;
                                    }
                                }
                            }
                            M3TextField { horizontal-stretch: 2; label: Tr.t("Название сборки"); text <=> root.edit-inst-name; }
                            M3TextField { horizontal-stretch: 1; label: Tr.t("Группа"); text <=> root.edit-inst-group; }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 8px;
                            Text {
                                text: "Папка на диске: instances/" + root.edit-inst-folder-name;
                                color: M3.on-surface-variant;
                                font-size: 11px;
                                font-family: "monospace";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.edit-inst-folder-name != root.edit-inst-name && root.edit-inst-name != "" : M3Chip {
                                text: Tr.t("Синхронизировать папку с названием");
                                clicked => { root.sync-instance-folder-name(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            M3Dropdown {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                                label: "Minecraft";
                                current-value <=> root.edit-inst-mc;
                                options: root.available-mc-versions;
                                selected(v) => {
                                    root.edit-inst-mc = v;
                                    root.refresh-edit-versions(root.edit-inst-loader-idx, v, root.include-snapshots);
                                    if root.edit-inst-loader-idx == 2 && root.edit-inst-optifine {
                                        root.refresh-optifine-versions(v);
                                    }
                                }
                            }
                            M3Dropdown {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                                label: root.edit-inst-loader-idx == 0 ? "Vanilla"
                                    : root.edit-inst-loader-idx == 1 ? "Fabric"
                                    : root.edit-inst-loader-idx == 2 ? "Forge"
                                    : root.edit-inst-loader-idx == 3 ? "NeoForge"
                                    : root.edit-inst-loader-idx == 4 ? "Quilt"
                                    : root.edit-inst-loader-idx == 5 ? "LiteLoader"
                                    : root.edit-inst-loader-idx == 6 ? "LabyMod 4"
                                    : root.edit-inst-loader-idx == 7 ? "OptiFine"
                                    : "Horizon (Rust)";
                                current-value <=> root.edit-inst-loader-ver;
                                options: root.available-loader-versions;
                                selected(v) => { root.edit-inst-loader-ver = v; }
                            }
                            if root.edit-inst-loader-idx == 2 && root.edit-inst-optifine : M3Dropdown {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                                label: "OptiFine";
                                current-value <=> root.edit-inst-optifine-ver;
                                options: root.available-optifine-versions;
                                selected(v) => { root.edit-inst-optifine-ver = v; }
                            }
                        }

                        Text { text: Tr.t("Загрузчик / Клиент:"); color: M3.on-surface-variant; font-size: 12px; font-weight: 600; }

                        LoaderSelectorGrid {
                            selected-index <=> root.edit-inst-loader-idx;
                            loader-selected(idx) => {
                                if idx != 2 { root.edit-inst-optifine = false; }
                                root.refresh-edit-versions(idx, root.edit-inst-mc, root.include-snapshots);
                                if idx == 2 { root.refresh-optifine-versions(root.edit-inst-mc); }
                            }
                        }

                        if root.edit-inst-loader-idx == 2 : M3Switch {
                            label: Tr.t("Добавить OptiFine (только для Forge)");
                            checked <=> root.edit-inst-optifine;
                            toggled(on) => { if on { root.refresh-optifine-versions(root.edit-inst-mc); } }
                        }

                        HorizontalLayout {
                            alignment: start;
                            M3Chip {
                                text: Tr.t("Расширенные");
                                selected: root.edit-show-advanced;
                                svg-path: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                                clicked => { root.edit-show-advanced = !root.edit-show-advanced; }
                            }
                        }

                        if root.edit-show-advanced : Rectangle {
                            background: M3.surface-low;
                            border-radius: 20px;
                            border-width: 1px;
                            border-color: M3.primary;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: Tr.t("Расширенные");
                                    color: M3.primary;
                                    font-size: 14px;
                                    font-weight: 800;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    M3TextField {
                                        horizontal-stretch: 1;
                                        label: Tr.t("Версия Minecraft (вручную)");
                                        text <=> root.edit-inst-mc;
                                        placeholder: "1.21.4";
                                    }
                                    M3TextField {
                                        horizontal-stretch: 1;
                                        label: Tr.t("Версия загрузчика (вручную)");
                                        text <=> root.edit-inst-loader-ver;
                                        placeholder: "0.16.10 / latest";
                                    }
                                }

                                Rectangle { height: 1px; background: M3.outline-variant; }

                                M3Switch {
                                    label: Tr.t("Использовать кастомный загрузчик");
                                    checked <=> root.edit-use-custom-loader;
                                }

                                if root.edit-use-custom-loader : VerticalLayout {
                                    spacing: 8px;
                                    M3TextField {
                                        label: Tr.t("Название загрузчика");
                                        text <=> root.edit-custom-loader-name;
                                        placeholder: "Cleanroom / Babric / Ornithe";
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        M3TextField {
                                            horizontal-stretch: 1;
                                            label: Tr.t("Файл профиля (.json) или .jar / URL");
                                            text <=> root.edit-custom-loader-path;
                                            placeholder: "/path/to/loader.json или https://...";
                                        }
                                        VerticalLayout {
                                            alignment: end;
                                            M3Chip {
                                                text: Tr.t("Обзор");
                                                clicked => { root.browse-file("custom_loader"); }
                                            }
                                        }
                                    }
                                    M3TextField {
                                        label: "Main Class (необязательно)";
                                        text <=> root.edit-custom-loader-main-class;
                                        placeholder: "net.minecraft.launchwrapper.Launch";
                                    }
                                }
                            }
                        }
                    }

                    // EDIT 2: MODS (MODRINTH + CURSEFORGE)
                    if root.edit-subtab == 2 : VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: root.show-mod-downloader ? "Скачать моды (Modrinth / CurseForge)" : "Установленные моды (" + root.installed-mods.length + ")"; color: M3.on-surface; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 8px;
                                M3Chip { text: Tr.t("Обновить моды"); clicked => { root.update-installed-mods(); } }
                                M3Chip { text: Tr.t("Папка mods"); clicked => { root.open-instance-subfolder("mods"); } }
                                M3PrimaryButton {
                                    btn-height: 36px;
                                    text: root.show-mod-downloader ? "К списку модов" : "Скачать моды";
                                    clicked => {
                                        root.show-mod-downloader = !root.show-mod-downloader;
                                        if root.show-mod-downloader && root.mod-search-results.length == 0 {
                                            root.search-asset("mod", root.mod-dl-provider, root.mod-search-query);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                            if !root.show-mod-downloader : M3ScrollView {
                                width: 100%;
                                height: 100%;
                                content-spacing: 8px;
                                for m in root.installed-mods : Rectangle {
                                    height: 56px;
                                    border-radius: 16px;
                                    background: M3.surface-low;
                                    border-width: 1px;
                                    border-color: m.enabled ? M3.outline-variant : M3.error.with-alpha(0.35);
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            M3Switch { y: (parent.height - self.height) / 2; checked: m.enabled; toggled => { root.toggle-installed-mod(m.filename); } }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: m.display_name; color: m.enabled ? M3.on-surface : M3.outline; font-size: 13px; font-weight: 700; }
                                                Text {
                                                    text: root.setting-show-mod-file-sizes
                                                        ? (m.size_kb + (m.enabled ? " • Включён" : " • Отключён"))
                                                        : (m.enabled ? "Включён" : "Отключён");
                                                    color: M3.on-surface-variant;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                        M3Chip { y: (parent.height - self.height) / 2; text: Tr.t("Удалить"); clicked => { root.delete-installed-mod(m.filename); } }
                                    }
                                }
                            }
                            if root.show-mod-downloader : AssetDownloaderPane {
                                provider-idx <=> root.mod-dl-provider;
                                query <=> root.mod-search-query;
                                placeholder: "Поиск модов (пусто — популярные)...";
                                results: root.mod-search-results;
                                cf-confirmed: root.cf-key-confirmed;
                                require-cf-key => { root.show-cf-key-modal = true; }
                                search(p, q) => { root.search-asset("mod", p, q); }
                                install(id, t, prov) => { root.install-asset("mod", id, t, prov); }
                            }
                        }
                    }

