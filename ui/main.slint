component M3Dropdown inherits Rectangle {
    in property <string> label: "";
    in-out property <string> current-value: "";
    in property <[string]> options: [];
    in-out property <bool> expanded: false;
    in property <color> field-bg: M3.surface-low;
    callback selected(string);

    min-width: 0px;
    preferred-width: 0px;
    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: 5px;
        alignment: start;

        if root.label != "" : Text {
            text: root.label;
            color: root.expanded ? M3.primary : M3.on-surface-variant;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
        }

        dd-trigger := Rectangle {
            height: 42px;
            min-width: 0px;
            preferred-width: 0px;
            border-radius: 14px * M3.radius-scale;
            background: root.expanded ? M3.surface-highest : (dd-t.has-hover ? M3.surface-high : root.field-bg);
            border-width: root.expanded ? 2px : 1px;
            border-color: root.expanded ? M3.primary : M3.outline-variant;
            animate background, border-color { duration: 130ms; }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.current-value;
                    color: M3.on-surface;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Path {
                    horizontal-stretch: 0;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    commands: root.expanded ? "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z" : "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z";
                    fill: M3.primary;
                }
            }

            dd-t := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    dd-popup.show();
                }
            }
        }
    }

    dd-popup := PopupWindow {
        x: 0px;
        y: dd-trigger.y + dd-trigger.height + 4px;
        width: max(160px, root.width);
        height: min(260px, max(48px, root.options.length * 36px + 14px));
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 14px * M3.radius-scale;
            background: M3.surface-high;
            border-width: 1.5px;
            border-color: M3.primary;
            clip: true;

            M3ScrollView {
                width: 100%;
                height: 100%;
                content-padding: 6px;
                content-spacing: 2px;

                if root.options.length == 0 : Rectangle {
                    height: 34px;
                    Text {
                        text: root.current-value != "" ? root.current-value : "Нет доступных сборок для этой версии";
                        color: M3.on-surface-variant;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                for opt in root.options : Rectangle {
                    height: 34px;
                    border-radius: 10px * M3.radius-scale;
                    background: opt == root.current-value ? M3.primary-container : (opt-t.has-hover ? M3.surface-highest : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text: opt;
                            color: opt == root.current-value ? M3.on-primary-container : M3.on-surface;
                            font-size: 13px;
                            font-weight: opt == root.current-value ? 700 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if opt == root.current-value : UiIcon {
                            icon-size: 14px;
                            y: (parent.height - self.height) / 2;
                            svg-path: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
                            icon-color: M3.on-primary-container;
                        }
                    }

                    opt-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-value = opt;
                            root.expanded = false;
                            dd-popup.close();
                            root.selected(opt);
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// 3-COLOR CIRCULAR PALETTE SWATCH
// ============================================================================
component TriColorSwatch inherits Rectangle {
    in property <string> label;
    in property <color> top-color;
    in property <color> bottom-left-color;
    in property <color> bottom-right-color;
    in property <bool> selected: false;
    callback clicked();

    preferred-width: 82px;
    height: 92px;
    border-radius: 20px;
    background: selected ? M3.surface-highest : (t.has-hover ? M3.surface-high : M3.surface-low);
    border-width: selected ? 2px : 1px;
    border-color: selected ? M3.primary : M3.outline-variant;
    animate background, border-color { duration: 150ms; }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 52px;
            height: 52px;
            x: (parent.width - self.width) / 2;
            border-radius: 26px;
            clip: true;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? M3.on-surface : M3.outline-variant;

            Rectangle { x: 0; y: 0; width: 52px; height: 26px; background: root.top-color; }
            Rectangle { x: 0; y: 26px; width: 26px; height: 26px; background: root.bottom-left-color; }
            Rectangle { x: 26px; y: 26px; width: 26px; height: 26px; background: root.bottom-right-color; }

            if root.selected : Rectangle {
                width: 22px;
                height: 22px;
                x: 15px;
                y: 15px;
                border-radius: 11px;
                background: M3.bg;
                Path {
                    width: 12px;
                    height: 12px;
                    x: 5px;
                    y: 5px;
                    commands: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
                    fill: root.top-color;
                }
            }
        }

        Text {
            text: root.label;
            color: root.selected ? M3.primary : M3.on-surface-variant;
            font-size: 10px;
            font-weight: root.selected ? 700 : 600;
            horizontal-alignment: center;
        }
    }

    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Rainbow Custom Color Swatch Button (opens Select Color modal like Screenshot 1!)
component RainbowColorSwatch inherits Rectangle {
    in property <string> label: "Свой цвет";
    in property <bool> selected: false;
    callback clicked();

    preferred-width: 82px;
    height: 92px;
    border-radius: 20px;
    background: selected ? M3.surface-highest : (rt.has-hover ? M3.surface-high : M3.surface-low);
    border-width: selected ? 2px : 1px;
    border-color: selected ? M3.primary : M3.outline-variant;
    animate background, border-color { duration: 150ms; }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 52px;
            height: 52px;
            x: (parent.width - self.width) / 2;
            border-radius: 26px;
            clip: true;
            background: @linear-gradient(135deg, #FF5E62 0%, #FFD166 25%, #38D39F 50%, #3B82F6 75%, #C084FC 100%);
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? M3.on-surface : M3.outline-variant;

            Rectangle {
                width: 28px;
                height: 28px;
                x: 12px;
                y: 12px;
                border-radius: 14px;
                background: #1B1829D8;
                Path {
                    width: 16px;
                    height: 16px;
                    x: 6px;
                    y: 6px;
                    commands: "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z";
                    fill: #FFFFFF;
                }
            }
        }

        Text {
            text: root.label;
            color: root.selected ? M3.primary : M3.on-surface-variant;
            font-size: 10px;
            font-weight: root.selected ? 700 : 600;
            horizontal-alignment: center;
        }
    }

    rt := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component M3Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label: "";
    callback toggled(bool);

    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 50px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: root.checked ? M3.primary : M3.surface-highest;
            border-width: root.checked ? 0px : 2px;
            border-color: M3.outline;
            animate background { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

            Rectangle {
                width: root.checked ? 20px : 14px;
                height: root.checked ? 20px : 14px;
                x: root.checked ? 26px : 6px;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.checked ? M3.on-primary : M3.outline;
                animate x, width, height, background { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
            }
        }

        if root.label != "" : Text {
            text: root.label;
            color: M3.on-surface;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component M3TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> label: "";
    in property <string> placeholder: "";
    in property <bool> is-password: false;
    in property <bool> enabled: true;
    in property <color> field-bg: M3.surface-low;
    callback accepted(string);
    callback edited(string);

    min-width: 0px;
    preferred-width: 0px;
    height: root.label != "" ? 64px : 42px;
    background: transparent;

    VerticalLayout {
        spacing: 5px;
        if root.label != "" : Text {
            text: root.label;
            color: !root.enabled ? M3.outline : (input.has-focus ? M3.primary : M3.on-surface-variant);
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
        }

        Rectangle {
            height: 42px;
            min-width: 0px;
            border-radius: 14px * M3.radius-scale;
            background: !root.enabled ? M3.bg : (input.has-focus ? M3.surface-high : root.field-bg);
            border-width: input.has-focus ? 2px : 1px;
            border-color: input.has-focus ? M3.primary : M3.outline-variant;
            animate background, border-color { duration: 140ms; }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    if root.text == "" && !input.has-focus : Text {
                        text: root.placeholder;
                        color: M3.outline;
                        font-size: 13px;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    input := TextInput {
                        text <=> root.text;
                        enabled: root.enabled;
                        color: root.enabled ? M3.on-surface : M3.outline;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: root.is-password ? InputType.password : InputType.text;
                        width: 100%;
                        height: 100%;
                        accepted => { root.accepted(root.text); }
                        edited => { root.edited(root.text); }
                    }
                }

                if root.text != "" && root.enabled : Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 11px;
                    background: clr-touch.has-hover ? M3.surface-highest : transparent;
                    Text {
                        text: "×";
                        color: M3.on-surface-variant;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    clr-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.text = "";
                            root.edited("");
                        }
                    }
                }
            }
        }
    }
}

component M3PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> svg-path: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> btn-height: 42px;
    callback clicked();

    height: root.btn-height;
    border-radius: (root.btn-height / 2) * M3.radius-scale;
    background: !enabled ? M3.surface-high : (
        root.danger
            ? (touch.pressed ? M3.error.darker(0.15) : (touch.has-hover ? M3.error.brighter(0.08) : M3.error))
            : (touch.pressed ? M3.primary.darker(0.1) : (touch.has-hover ? M3.primary.brighter(0.12) : M3.primary))
    );
    animate background { duration: 140ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;

        if root.svg-path != "" : UiIcon {
            icon-size: 17px;
            y: (parent.height - self.height) / 2;
            svg-path: root.svg-path;
            icon-color: !root.enabled ? M3.outline : (root.danger ? #1F0000 : M3.on-primary);
        }

        Text {
            text: root.text;
            color: !root.enabled ? M3.outline : (root.danger ? #1F0000 : M3.on-primary);
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component M3ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <string> svg-path;
    in property <bool> active: false;
    in property <bool> managed-pill: false;
    callback clicked();

    height: 36px;
    border-radius: 18px * M3.radius-scale;
    background: managed-pill ? ((!active && touch.has-hover) ? M3.surface-high : transparent) : (active ? M3.primary-container : (touch.has-hover ? M3.surface-high : transparent));
    animate background { duration: 140ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: start;

        UiIcon {
            icon-size: 16px;
            y: (parent.height - self.height) / 2;
            svg-path: root.svg-path;
            icon-color: root.active ? M3.on-primary-container : M3.on-surface-variant;
        }

        Text {
            text: root.text;
            color: root.active ? M3.on-primary-container : M3.on-surface;
            font-size: 13px;
            font-weight: root.active ? 700 : 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component M3SidebarAction inherits Rectangle {
    in property <string> text;
    in property <string> svg-path;
    in property <bool> danger: false;
    callback clicked();

    height: 38px;
    border-radius: 14px;
    background: touch.has-hover ? (root.danger ? M3.error-container : M3.surface-high) : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        UiIcon {
            icon-size: 17px;
            y: (parent.height - self.height) / 2;
            svg-path: root.svg-path;
            icon-color: root.danger ? M3.error : M3.on-surface-variant;
        }

        Text {
            text: root.text;
            color: root.danger ? M3.error : M3.on-surface;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component M3Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <string> svg-path: "";
    in property <bool> managed-pill: false;
    in property <bool> keep-unselected-pill: false;
    callback clicked();

    height: 34px;
    border-radius: 17px * M3.radius-scale;
    background: managed-pill
        ? (keep-unselected-pill
            ? (selected ? transparent : (touch.has-hover ? M3.surface-highest : M3.surface-high))
            : ((!selected && touch.has-hover) ? M3.surface-highest.with-alpha(0.6) : transparent))
        : (selected ? M3.primary-container : (touch.has-hover ? M3.surface-highest : M3.surface-high));
    border-width: managed-pill ? ((keep-unselected-pill && !selected) ? 1px : 0px) : (selected ? 1.5px : 1px);
    border-color: managed-pill ? ((keep-unselected-pill && !selected) ? M3.outline-variant : transparent) : (selected ? M3.primary : M3.outline-variant);
    animate background, border-color { duration: 140ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.selected && !root.managed-pill : Path {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            commands: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
            fill: M3.on-primary-container;
        }

        if !root.selected && root.svg-path != "" : Path {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            commands: root.svg-path;
            fill: M3.on-surface-variant;
        }

        Text {
            text: root.text;
            color: root.selected ? M3.on-primary-container : M3.on-surface;
            font-size: 12px;
            font-weight: root.selected ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LoaderSelectorGrid inherits Rectangle {
    in property <[string]> loaders: [
        "Vanilla",
        "Fabric",
        "Forge",
        "NeoForge",
        "Quilt",
        "LiteLoader",
        "LabyMod 4",
        "OptiFine",
        "Horizon (Rust)"
    ];
    in-out property <int> selected-index: 0;
    callback loader-selected(int);

    property <length> cell-w: max(0px, (self.width - 12px) / 3);
    height: grid-layout.preferred-height;
    background: transparent;

    // 2D Jumping Capsule across separate grid cells (without merging into 1 row!)
    Rectangle {
        x: mod(root.selected-index, 3) * (root.cell-w + 6px);
        y: floor(root.selected-index / 3) * 40px;
        width: root.cell-w;
        height: 34px;
        border-radius: 17px * M3.radius-scale;
        background: M3.primary-container;
        border-width: 1.5px;
        border-color: M3.primary;
        animate x, y, width { duration: M3.animations-enabled ? 220ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
    }

    grid-layout := VerticalLayout {
        width: 100%;
        spacing: 6px;

        for r in [0, 1, 2, 3, 4] : HorizontalLayout {
            property <bool> row-visible: r * 3 < root.loaders.length;
            height: row-visible ? 34px : 0px;
            visible: row-visible;
            spacing: 6px;

            for c in [0, 1, 2] : Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                property <int> idx: r * 3 + c;
                property <bool> has-item: idx < root.loaders.length;
                background: transparent;

                if has-item : M3Chip {
                    managed-pill: true;
                    keep-unselected-pill: true;
                    width: 100%;
                    height: 100%;
                    text: root.loaders[idx];
                    selected: root.selected-index == idx;
                    clicked => {
                        root.selected-index = idx;
                        root.loader-selected(idx);
                    }
                }
            }
        }
    }
}

component M3SegmentTab inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <bool> active: false;
    in property <bool> managed-pill: false;
    callback clicked();

    height: 44px;
    border-radius: 22px;
    background: managed-pill ? ((!active && touch.has-hover) ? M3.surface-highest : transparent) : (active ? M3.primary : (touch.has-hover ? M3.surface-highest : transparent));
    animate background { duration: 150ms; }

    VerticalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.title;
            color: root.active ? M3.on-primary : M3.on-surface;
            font-size: 13px;
            font-weight: root.active ? 800 : 600;
            horizontal-alignment: center;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: root.active ? M3.on-primary.with-alpha(0.85) : M3.on-surface-variant;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InstanceIconBadge inherits Rectangle {
    in property <int> icon-id: 0;
    in property <image> icon-image;
    in property <string> label: "MC";
    in property <bool> selected: false;
    in property <length> size: 48px;

    property <color> badge-bg:
        selected ? M3.primary :
        icon-id == 1 ? #264F3B :
        icon-id == 2 ? #5C3A28 :
        icon-id == 3 ? #4D3059 :
        icon-id == 4 ? #254659 :
        icon-id == 5 ? #574A22 :
        icon-id == 6 ? #5A2B3D :
        icon-id == 7 ? #2B4B4B : M3.secondary-container;

    width: root.size;
    height: root.size;
    border-radius: M3.widget-frame-idx == 2 ? root.size * 0.08 : (M3.widget-frame-idx == 1 ? root.size * 0.16 : root.size * 0.28);
    background: root.icon-image.width > 0 ? transparent : badge-bg;
    border-width: root.selected ? 2px : 0px;
    border-color: M3.primary;
    clip: true;

    if root.icon-image.width > 0 : Image {
        width: root.size;
        height: root.size;
        source: root.icon-image;
        image-fit: contain;
        image-rendering: (M3.widget-frame-idx == 2 || M3.icon-theme-idx == 3) ? pixelated : smooth;
    }

    if root.icon-image.width == 0 : Text {
        text: root.label;
        color: root.selected ? M3.on-primary : #F2F5FC;
        font-size: root.size > 60px ? 11px : 9px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Reusable Modrinth + CurseForge Downloader Pane for Mods / ResourcePacks / Shaders / DataPacks / Worlds
component AssetDownloaderPane inherits VerticalLayout {
    in-out property <int> provider-idx: 0; // 0 = Modrinth, 1 = CurseForge, 2 = Оба
    in-out property <string> query: "";
    in property <string> placeholder: "Поиск (пусто — популярные)...";
    in property <[UiModHit]> results: [];
    in property <bool> cf-confirmed: false;
    callback require-cf-key();
    callback search(int, string);
    callback install(string, string, string);

    width: 100%;
    height: 100%;
    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            height: 38px;
            border-radius: 19px * M3.radius-scale;
            background: M3.surface-high;
            border-width: 1px;
            border-color: M3.outline-variant;

            Rectangle {
                y: 2px;
                height: 34px;
                border-radius: 17px * M3.radius-scale;
                background: M3.primary-container;
                border-width: 1.5px;
                border-color: M3.primary;
                x: root.provider-idx == 1 ? ad-prov-1.x : (root.provider-idx == 2 ? ad-prov-2.x : ad-prov-0.x);
                width: root.provider-idx == 1 ? ad-prov-1.width : (root.provider-idx == 2 ? ad-prov-2.width : ad-prov-0.width);
                animate x, width { duration: M3.animations-enabled ? 220ms : 0ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
            }

            HorizontalLayout {
                padding: 2px;
                spacing: 4px;
                ad-prov-0 := M3Chip {
                    managed-pill: true;
                    text: "Modrinth";
                    selected: root.provider-idx == 0;
                    clicked => { root.provider-idx = 0; root.search(0, root.query); }
                }
                ad-prov-1 := M3Chip {
                    managed-pill: true;
                    text: "CurseForge";
                    selected: root.provider-idx == 1;
                    clicked => {
                        root.provider-idx = 1;
                        if !root.cf-confirmed { root.require-cf-key(); }
                        else { root.search(1, root.query); }
                    }
                }
                ad-prov-2 := M3Chip {
                    managed-pill: true;
                    text: Tr.t("Оба");
                    selected: root.provider-idx == 2;
                    clicked => {
                        root.provider-idx = 2;
                        root.search(2, root.query);
                    }
                }
            }
        }
        M3TextField {
            horizontal-stretch: 1;
            text <=> root.query;
            placeholder: root.placeholder;
            edited(q) => { root.search(root.provider-idx, q); }
            accepted => { root.search(root.provider-idx, root.query); }
        }
        M3PrimaryButton {
            horizontal-stretch: 0;
            btn-height: 42px;
            text: Tr.t("Найти");
            clicked => { root.search(root.provider-idx, root.query); }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: transparent;

        M3ScrollView {
            width: 100%;
            height: 100%;
            content-spacing: 8px;
            for item in root.results : Rectangle {
                height: 70px;
                border-radius: 16px;
                background: M3.surface-low;
                border-width: 1px;
                border-color: M3.outline-variant;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: space-between;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: M3.surface-high;
                        clip: true;
                        if item.icon.width > 0 : Image {
                            x: 2px;
                            y: 2px;
                            width: parent.width - 4px;
                            height: parent.height - 4px;
                            source: item.icon;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        alignment: center;
                        Text { text: item.title + " • " + item.author + " (" + item.provider + ")"; color: M3.on-surface; font-size: 13px; font-weight: 700; overflow: elide; }
                        Text { text: item.description; color: M3.on-surface-variant; font-size: 11px; overflow: elide; }
                    }
                    M3PrimaryButton {
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        btn-height: 34px;
                        text: Tr.t("Установить");
                        clicked => { root.install(item.project_id, item.title, item.provider); }
                    }
                }
            }
        }
    }
}

// ============================================================================
// MAIN WINDOW
// ============================================================================
export component MainWindow inherits Window {
    title: "AxyLauncher";
    icon: root.app-icon;
    default-font-family: M3.ui-font;
    preferred-width: 1260px;
    preferred-height: 800px;
    min-width: 780px;
    min-height: 540px;
    background: M3.bg;

    in-out property <image> app-icon;
    in-out property <bool> is-linux: true;

    // Active Views: 0 = Сборки, 1 = Аккаунты, 3 = Настройки, 4 = Консоль, 5 = Редактирование сборки
    in-out property <int> active-tab: 0;
    in-out property <bool> show-create-modal: false;
    in-out property <bool> show-export-menu: false;

    // Available Languages (Dropdown in Setup Wizard & Settings!)
    property <[string]> language-options: [
        "English (US)",
        "Русский (RU)",
        "Українська (UA)",
        "Español (ES)",
        "Français (FR)",
        "Deutsch (DE)",
        "Polski (PL)",
        "中文 (ZH)",
        "日本語 (JA)"
    ];

    // FreesmLauncher Visual Features: Animated Snow, Cat Pack & Custom Backgrounds!
    in-out property <bool> setting-ui-animations: true;
    in-out property <bool> setting-wavy-progress: true;
    in-out property <bool> setting-snow-effect: false;
    in-out property <bool> setting-enable-cat-pack: false;
    in-out property <int> setting-cat-preset: 1;
    in-out property <float> setting-cat-opacity: 0.25;
    in-out property <string> setting-cat-custom-path: "";
    in-out property <int> setting-cat-scale-mode: 2; // 0=Fit, 1=Fill, 2=Cover, 3=Stretch
    in-out property <image> cat-pack-image;
    in-out property <bool> has-cat-image: false;

    in-out property <bool> setting-enable-custom-bg: false;
    in-out property <int> setting-custom-bg-mode: 0; // 0=Launcher, 1=Instances, 2=Both same, 3=Two separate
    in-out property <string> setting-bg-launcher-path: "";
    in-out property <float> setting-bg-launcher-opacity: 0.35;
    in-out property <int> setting-bg-launcher-scale: 1; // 0=Fit, 1=Cover, 2=Stretch
    in-out property <image> custom-bg-launcher-image;
    in-out property <bool> has-launcher-bg-image: false;
    in-out property <string> setting-bg-instances-path: "";
    in-out property <float> setting-bg-instances-opacity: 0.35;
    in-out property <int> setting-bg-instances-scale: 1;
    in-out property <image> custom-bg-instances-image;
    in-out property <bool> has-instances-bg-image: false;

    property <float> snow-tick: 0.0;
    property <float> wave-phase: 0.0;

    Timer {
        interval: 33ms;
        running: root.setting-snow-effect;
        triggered => {
            root.snow-tick = mod(root.snow-tick + 0.008, 1.0);
        }
    }

    Timer {
        interval: 40ms;
        running: M3.wavy-progress && (root.launch-progress > 0.0 || (root.show-download-modal && !root.download-modal-done && !root.download-modal-error));
        triggered => {
            root.wave-phase = mod(root.wave-phase + 0.14, 6.28318);
        }
    }

    // Instance Download / Preparation Progress Modal (Pixel M3 Expressive Wavy Bar)
    in-out property <bool> show-download-modal: false;
    in-out property <string> download-modal-title: "";
    in-out property <string> download-modal-subtitle: "";
    in-out property <string> download-modal-status: "";
    in-out property <float> download-modal-progress: 0.0;
    in-out property <bool> download-modal-done: false;
    in-out property <bool> download-modal-error: false;

    // First-Run Setup Wizard
    in-out property <bool> show-setup-wizard: false;
    in-out property <int> wizard-step: 0;
    in-out property <string> wizard-offline-nick: "";

    // CurseForge API Key Prompt Modal & Rename Instance Folder Modal (Freesm/Prism!)
    in-out property <bool> show-cf-key-modal: false;
    in-out property <bool> cf-key-confirmed: false;
    in-out property <string> setting-cf-api-key: "";
    in-out property <bool> show-rename-folder-modal: false;
    in-out property <string> rename-folder-old: "";
    in-out property <string> rename-folder-new: "";
    in-out property <string> rename-folder-inst-name: "";
    in-out property <bool> rename-folder-remember: false;

    // Custom Accent Color Picker Modal (Screenshot 1!)
    in-out property <bool> show-color-picker-modal: false;
    in-out property <string> custom-accent-hex: "#7C5CBF";
    in-out property <color> custom-accent-preview: #7C5CBF;
    in-out property <[UiColorSwatch]> custom-saved-colors: [];

    // Microsoft Skin & Cape Manager Modal (Screenshot 2!)
    in-out property <bool> show-skin-modal: false;
    in-out property <string> skin-account-id: "";
    in-out property <string> skin-account-name: "";
    in-out property <string> skin-status-text: "";
    in-out property <bool> skin-is-slim: false;
    in-out property <bool> skin-preview-elytra: false;
    in-out property <image> skin-preview-image;
    in-out property <image> cape-preview-image;
    in-out property <string> selected-skin-path: "";
    in-out property <[UiSkinEntry]> saved-skins: [];
    in-out property <string> selected-cape-name: "Без плаща";
    in-out property <[string]> available-capes: ["Без плаща"];
    in-out property <string> skin-import-input: "";

    // Create Instance Dialog Mode (NO pre-filled pack names!)
    in-out property <int> create-mode-idx: 0;
    in-out property <int> external-provider-idx: 0;
    in-out property <string> modpack-search-query: "";
    in-out property <[UiModHit]> modpack-search-results: [];
    in-out property <string> import-archive-path: "";
    in-out property <string> migrate-launcher-path: "";

    // Instances Filter, Search & Sort
    in-out property <string> instance-search-query: "";
    in-out property <string> instance-group-filter: "Все";
    in-out property <[string]> instance-groups: ["Все", "Основное", "Модпаки", "Клиенты"];
    in-out property <[UiInstance]> instances: [];
    in-out property <int> selected-instance-index: 0;
    in-out property <string> selected-instance-name: "Fabric 1.21.1";
    in-out property <string> selected-instance-group: "Основное";
    in-out property <string> selected-instance-mc: "1.21.1";
    in-out property <string> selected-instance-loader: "Fabric";
    in-out property <string> selected-instance-loader-ver: "0.16.9";
    in-out property <int> selected-instance-icon-id: 1;
    in-out property <image> selected-instance-icon-image;
    in-out property <string> selected-instance-optifine: "Выключен";
    in-out property <string> selected-instance-effective-ram: "4096 МБ";
    in-out property <string> selected-instance-playtime: "Готов";

    // 60 Pixel-Art Minecraft Instance Icons & Icon Picker Modal
    in-out property <[UiInstanceIcon]> instance-icons: [];
    in-out property <bool> show-icon-picker-modal: false;
    in-out property <bool> icon-picker-for-new: false;

    // Full Edit Instance State (10 sections!)
    //   0=Журнал, 1=Версия, 2=Моды, 3=Ресурспаки, 4=Шейдеры,
    //   5=Датапаки, 6=Миры, 7=Скриншоты, 8=Заметки, 9=Настройки сборки
    in-out property <int> edit-subtab: 1;
    in-out property <string> edit-inst-name: "";
    in-out property <string> edit-inst-folder-name: "";
    in-out property <string> edit-inst-group: "";
    in-out property <string> edit-inst-mc: "";
    in-out property <int> edit-inst-loader-idx: 0;
    in-out property <string> edit-inst-loader-ver: "";
    in-out property <bool> edit-show-advanced: false;
    in-out property <bool> edit-use-custom-loader: false;
    in-out property <string> edit-custom-loader-name: "";
